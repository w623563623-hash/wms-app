# ===== WMS 后端环境变量 =====
# 复制本文件为 .env 后填写。所有连接参数均走环境变量，便于在本地 / CloudBase 间切换。

# 服务端口
PORT=3000

# JWT 签名密钥（正式环境务必改成随机长串）
JWT_SECRET=change-me-to-a-long-random-string

# ===== 数据库连接 =====
# 本地开发（docker-compose 起一个 MySQL 8）：
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=wms123456
#   DB_NAME=wms
#
# 腾讯云 CloudBase MySQL（已开通实例，库名 = 环境 ID）：
#   DB_HOST=172.17.0.15      # 实例内网地址，仅同 VPC 的 CloudRun/云函数可访问
#   DB_PORT=3306
#   DB_USER=root             # 在 CloudBase 控制台「数据库 → 账号管理」查看/重置
#   DB_PASSWORD=             # 在控制台设置后填写（密码无法经 API 获取）
#   DB_NAME=w2026-d3gl5d1a5403e9caa
#
# 若要在沙箱/本地直连 CloudBase MySQL，需先在控制台开启「外网访问」并放行 IP，
# 然后把 DB_HOST 改为控制台给出的外网地址。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=wms123456
DB_NAME=wms
